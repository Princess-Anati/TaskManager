DATABASE_URL="postgresql://user:password@localhost:5432/taskmanager"
PORT=5000
JWT_SECRET="replace-with-a-long-random-string"
CORS_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
# Get a key at https://resend.com — leave unset to log invitation emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM="Taskly <onboarding@resend.dev>"
# Web Push VAPID keypair — generate your own with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY must also be set as VITE_VAPID_PUBLIC_KEY in frontend/.env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@example.com"
# How often (ms) the reminder dispatch worker polls for due reminders.
REMINDER_POLL_INTERVAL_MS=30000
# Cloudflare R2 (or any S3-compatible) object storage for uploaded files and
# avatars. Leave all four unset for local dev — falls back to local disk
# automatically. Required in production on hosts with ephemeral disk (most
# free tiers wipe local files on every restart/redeploy). See docs/DEPLOYMENT.md.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Billing / subscriptions ─────────────────────────────────────────────
# All three payment providers below are fully wired (checkout, webhooks,
# subscription activation/renewal/cancellation) and degrade gracefully —
# each one individually 503s on its own checkout/webhook routes until its
# own keys are set, with the rest of the app (and the other providers)
# unaffected. Nothing here needs code changes, only the values below.
# Optional overrides for where a completed/cancelled checkout redirects to
# — default to APP_URL/app/billing?status=success|cancelled if left unset.
FRONTEND_CHECKOUT_SUCCESS_URL=
FRONTEND_CHECKOUT_CANCEL_URL=

# Stripe — https://dashboard.stripe.com/test/apikeys (use the *test mode*
# keys until you're ready to go live; they're prefixed sk_test_/whsec_test_
# vs sk_live_/whsec_).
STRIPE_SECRET_KEY=
# Created under https://dashboard.stripe.com/test/webhooks — point it at
# POST {your backend URL}/api/payments/stripe/webhook, subscribed to at
# least: checkout.session.completed, invoice.payment_succeeded,
# invoice.payment_failed, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=
# One Stripe Price object per (plan, billing cycle) — create these in the
# Stripe dashboard/CLI first (Product "Taskly Premium"/"Taskly Team", a
# monthly and an annual Price on each), then paste their price_... ids here.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=

# PayPal — https://developer.paypal.com/dashboard/applications (use a
# Sandbox app's credentials until you're ready to go live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Defaults to the sandbox API — switch to https://api-m.paypal.com in
# production once you're using live credentials above.
PAYPAL_API_BASE="https://api-m.sandbox.paypal.com"
# Create a webhook under the same dashboard page pointed at
# POST {your backend URL}/api/payments/paypal/webhook, subscribed to at
# least PAYMENT.CAPTURE.COMPLETED and PAYMENT.CAPTURE.DENIED — then copy
# its Webhook ID (not a secret string) here.
PAYPAL_WEBHOOK_ID=

# Flutterwave — https://dashboard.flutterwave.com/settings/apis (use the
# Test/sandbox secret key until you're ready to go live). Supports
# Uganda-friendly payment methods including mobile money automatically —
# nothing extra to configure, Flutterwave's hosted payment page offers
# whichever methods are enabled for your account/region.
FLUTTERWAVE_SECRET_KEY=
# Set under Settings -> Webhooks in the Flutterwave dashboard as the
# "Secret Hash" (not a signature — Flutterwave verifies webhooks via a
# shared string compared against the `verif-hash` request header, rather
# than HMAC). Point the webhook URL at
# POST {your backend URL}/api/payments/flutterwave/webhook.
FLUTTERWAVE_SECRET_HASH=
# Not required by this integration — Flutterwave's client-side/inline SDK
# needs a public key, but this app only uses their server-side Payments API
# (a hosted redirect link), so there's nothing to wire it into. Left here
# only in case you later add the inline checkout widget.
FLUTTERWAVE_PUBLIC_KEY=
