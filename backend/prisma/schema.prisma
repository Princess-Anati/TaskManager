generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String   @id @default(uuid())
  firstname                 String
  lastName                  String
  email                     String   @unique
  password                  String
  avatarUrl                 String?
  bio                       String?
  isActive                  Boolean  @default(true)
  language                  String   @default("en")
  fontStyle                 String   @default("default")
  colorTheme                String   @default("purple")
  taskNotificationsEnabled  Boolean  @default(true)
  emailNotificationsEnabled Boolean  @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  workspaceMembers       WorkspaceMember[]
  assignedTasks          Task[]                  @relation("AssignedTasks")
  completedTasks         Task[]                  @relation("CompletedTasks")
  activityLogs           ActivityLog[]
  notifications          Notification[]
  workspaceInvitations   WorkspaceInvitation[]   @relation("InvitedBy")
  sessions               Session[]
  payments               Payment[]
  comments               Comment[]
  files                  File[]
  pushSubscriptions      PushSubscription[]
  notificationPreference NotificationPreference?
  reminderSchedules      ReminderSchedule[]
  userAchievements       UserAchievement[]
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        WorkspaceType @default(PERSONAL)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks         Task[]
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  files         File[]
  subscription  Subscription?
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Task {
  id                         String          @id @default(uuid())
  title                      String
  description                String?
  priority                   TaskPriority    @default(MEDIUM)
  status                     TaskStatus      @default(TODO)
  dueDate                    DateTime?
  completedAt                DateTime?
  // Who actually marked the task complete — distinct from assignedToId.
  // Achievements/insights credit this, not the assignee: a solo user very
  // often completes tasks they never bothered to explicitly assign to
  // themselves, and assignment tracks delegation/ownership, not who did
  // the work of finishing it.
  completedById              String?
  estimatedMinutes           Int?
  // Client-generated idempotency key for offline-created tasks — lets the
  // sync layer safely retry a "create" mutation (e.g. after a dropped
  // response) without producing a duplicate task.
  clientId                   String?         @unique
  workspaceId                String
  assignedToId               String?
  labels                     String[]        @default([])
  parentTaskId               String?
  isRecurring                Boolean         @default(false)
  recurrenceRule             RecurrenceRule?
  // Recurrence engine config (only meaningful when isRecurring is true).
  // interval multiplies the base unit ("every N days/weeks/months/years");
  // daysOfWeek (0=Sun..6=Sat) restricts a WEEKLY rule to specific weekdays;
  // businessDaysOnly skips generated occurrences that land on a weekend.
  recurrenceInterval         Int?
  recurrenceDaysOfWeek       Int[]           @default([])
  recurrenceBusinessDaysOnly Boolean         @default(false)
  recurrenceEndDate          DateTime?
  recurrenceCount            Int?
  recurrenceOccurrenceNumber Int             @default(1)
  recurrenceParentId         String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedTo        User?              @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedBy       User?              @relation("CompletedTasks", fields: [completedById], references: [id], onDelete: SetNull)
  activityLogs      ActivityLog[]
  notifications     Notification[]
  comments          Comment[]
  files             File[]
  reminderSchedules ReminderSchedule[]

  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("Subtasks")

  recurrenceParent   Task?  @relation("RecurrenceChain", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren Task[] @relation("RecurrenceChain")

  dependsOn Task[] @relation("TaskDependencies")
  blocks    Task[] @relation("TaskDependencies")

  @@index([workspaceId, status])
  @@index([assignedToId, status])
  @@index([completedById, status])
  @@index([workspaceId, dueDate])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  body      String
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model File {
  id           String   @id @default(uuid())
  workspaceId  String
  taskId       String?
  uploadedById String
  filename     String
  storedName   String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String?
  entityId    String?
  userId      String
  workspaceId String?
  taskId      String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id                 String           @id @default(uuid())
  userId             String
  workspaceId        String?
  taskId             String?
  reminderScheduleId String?
  type               NotificationType
  message            String
  isRead             Boolean          @default(false)
  createdAt          DateTime         @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task             Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reminderSchedule ReminderSchedule? @relation(fields: [reminderScheduleId], references: [id], onDelete: SetNull)
}

// One row per device/browser a user has granted Web Push permission on.
// `endpoint` is globally unique per browser installation, so it doubles as
// the natural upsert key when a client re-subscribes.
model PushSubscription {
  id         String   @id @default(uuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  pushEnabled            Boolean  @default(true)
  soundEnabled           Boolean  @default(true)
  vibrationEnabled       Boolean  @default(true)
  defaultReminderMinutes Int[]    @default([15])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Static catalog of achievements (streaks, milestones). Seeded idempotently
// at server boot (see achievementService.ensureAchievementsSeeded) rather
// than requiring a manual seed run, so the catalog is always present.
model Achievement {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]
}

// One row per (user, achievement) the user has actually earned — earning is
// permanent once granted, so this doubles as the "earned at" audit record.
model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// A single scheduled reminder for one user on one task. Offset-based
// reminders (5m/10m/.../1d before) store `offsetMinutes` so they can be
// recomputed if the due date changes; fully custom reminders leave it null
// and `remindAt` is authoritative.
model ReminderSchedule {
  id            String         @id @default(uuid())
  taskId        String
  userId        String
  offsetMinutes Int?
  remindAt      DateTime
  label         String
  status        ReminderStatus @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  task          Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([status, remindAt])
  @@index([taskId])
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  SNOOZED
}

model WorkspaceInvitation {
  id          String           @id @default(uuid())
  email       String
  workspaceId String
  invitedById String
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  role        WorkspaceRole    @default(MEMBER)
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([email, workspaceId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

enum RecurrenceRule {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanKey {
  FREE
  PREMIUM
  TEAM
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  FLUTTERWAVE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_UPDATED
  TASK_DELETED
  WORKSPACE_INVITED
  DUE_DATE_REMINDER
}

model Plan {
  id                       String   @id @default(uuid())
  key                      PlanKey  @unique
  name                     String
  priceMonthlyCents        Int
  priceAnnualCents         Int
  maxWorkspaces            Int?
  maxTasksPerWorkspace     Int?
  maxWorkspaceMembers      Int?
  canUseKanban             Boolean  @default(false)
  canUseCalendar           Boolean  @default(false)
  canUseTimeline           Boolean  @default(false)
  canUseSubtasks           Boolean  @default(false)
  canUseRecurringTasks     Boolean  @default(false)
  canUseDependencies       Boolean  @default(false)
  canUseLabels             Boolean  @default(false)
  canUseAdvancedFilters    Boolean  @default(false)
  canUseAnalytics          Boolean  @default(false)
  canUseFileAttachments    Boolean  @default(false)
  canUseExport             Boolean  @default(false)
  canUseCustomDashboard    Boolean  @default(false)
  canUseEmailNotifications Boolean  @default(false)
  canCreateTeamWorkspace   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(uuid())
  workspaceId            String             @unique
  planId                 String
  status                 SubscriptionStatus @default(ACTIVE)
  billingCycle           BillingCycle       @default(MONTHLY)
  provider               PaymentProvider?
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
  payments  Payment[]
}

model Payment {
  id                String          @id @default(uuid())
  subscriptionId    String
  userId            String
  provider          PaymentProvider
  providerPaymentId String          @unique
  amountCents       Int
  currency          String          @default("USD")
  billingCycle      BillingCycle
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Event-level idempotency ledger for provider webhooks — checked (and
// written to) before any side effects run, so a redelivered webhook short-
// circuits immediately instead of relying only on downstream unique
// constraints (e.g. Payment.providerPaymentId) to absorb duplicates.
model WebhookEvent {
  id         String          @id @default(uuid())
  provider   PaymentProvider
  externalId String
  createdAt  DateTime        @default(now())

  @@unique([provider, externalId])
}
